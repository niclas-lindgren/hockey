#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PYTHON_BIN="$ROOT_DIR/venv/bin/python3"

if [[ -x "$PYTHON_BIN" ]]; then
  PYTHON_CMD="$PYTHON_BIN"
else
  PYTHON_CMD=python3
fi

set +e
"$PYTHON_CMD" -m tournament_scheduler.cli.rvv_cli "$@"
status=$?
set -e


exit $status
